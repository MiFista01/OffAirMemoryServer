DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=off_air_memory

BACKUP_EXE=mysqldump
BACKUP_ON=false

MEDIA_ROOT=X:/
STREAM_ROOT=./stream-out
SCAN_ON_BOOT=false
NGINX_ON=false

FRONT_URL=http://localhost:4200
API_NAME=api
JWT_KEY=change-me
TOKEN_TIME=2d
# Required when PROJECT_STATUS is deploy or production
SESSION_SECRET=change-me

THROTTLE_TTL=60000
THROTTLE_LIMIT=15

# develop | deploy | production  (deploy/production = hardened mode)
PROJECT_STATUS=develop
PORT=3000
