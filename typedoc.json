{
    "entryPoints": [
        "src"
    ],
    "entryPointStrategy": "expand",
    "out": "docs/typedoc",
    "name": "Crime Game API - Code Documentation",
    "includeVersion": true,
    "excludePrivate": false,
    "excludeProtected": false,
    "excludeExternals": false,
    "skipErrorChecking": true,
    "readme": "README.md",
    "exclude": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/test/**",
        "**/documentation/**",
        "**/node_modules/**",
        "**/dist/**"
    ],
    "theme": "default",
    "excludeNotDocumented": false
}