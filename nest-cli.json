{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": { "extensions": [".ts"], "sourceMaps": true }
    },

    "typeCheck": false,
    "deleteOutDir": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "assets": [
    {
      "include": "**/*.sql",
      "watchAssets": true
    }
  ]
  },
  "watchOptions": {
    "watch": true,
    "watchAssets": false,
    "watchExclude": [
      "**/*.spec.ts",
      "**/node_modules/**",
      "**/dist/**",
      "**/logs/**",
      "**/backups/**",
      "**/public/**",
      "**/*.log"
    ],
    "debounce": 2000
  }
}
